# FROM registry.gitlab.com/ndmspc/user/al9:dep AS builder
FROM registry.gitlab.com/ndmspc/user/al10:dep AS builder
ARG MY_PROJECT_VER=9999.0.0
# COPY . brings in the whole tree; what actually lands in the image is trimmed by
# .dockerignore (VCS metadata, build outputs, and dev-only files), which also keeps
# irrelevant churn from busting this layer and forcing a full rebuild.
COPY . /builder/
WORKDIR /builder

# RUN dnf update -y && \
#   dnf module enable nodejs:22 -y && \
#   dnf install nodejs npm -y && \
#   rm -rf /var/cache/dnf/*

# RUN dnf update -y && \
#   dnf install nodejs -y && \
#   rm -rf /var/cache/dnf/*

RUN scripts/make.sh clean rpm taxi ui
# RUN git clone https://gitlab.com/ndmspc/ndmspc-ui.git && \
#   cd ndmspc-ui && npm install && npm run build && \
#   rm -rf node_modules ~/.npm /tmp/*

# FROM docker.io/library/almalinux:9
FROM docker.io/library/almalinux:10
ARG MY_USER=user
# Everything that touches the filesystem in this stage lives in one layer: repo
# setup, package install, tini, and the user. (dnf clean all already empties
# /var/cache/dnf, so no separate wipe; a separate useradd layer would each be a
# full filesystem copy under the CI's vfs storage driver.) ENV is image config, not
# a layer, so setting ROOT_INCLUDE_PATH here afterwards costs nothing.
# No `dnf update`: a full-OS upgrade on every build is slow and non-reproducible;
# refresh the almalinux base image instead when OS updates are wanted.
# The ndmspc RPMs are bind-mounted from the builder stage instead of COPYed in, so
# they never become an image layer and this stage keeps its build cache (which
# `--squash` would throw away). Nothing to `rm` afterwards, either.
RUN --mount=type=bind,from=builder,source=/builder/build/RPMS/x86_64,target=/rpms \
  dnf install epel-release 'dnf-command(config-manager)' 'dnf-command(copr)' -y && \
  dnf config-manager --set-enabled crb && \
  dnf copr enable ndmspc/stable -y && \
  dnf install -y /rpms/ndmspc*.rpm && \
  dnf clean all && \
  TINI_VERSION=v0.19.0 && \
  curl -fsSL https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini -o /usr/bin/tini && \
  chmod +x /usr/bin/tini && \
  groupadd -g 1000 ${MY_USER} && \
  useradd -u 1000 -g ${MY_USER} -m -s /bin/bash ${MY_USER} && \
  mkdir -p /ndmspc && \
  chown -R ${MY_USER}:${MY_USER} /ndmspc
# ENV ROOT_INCLUDE_PATH="/usr/include/ndmspc:/usr/include/root"
USER 1000
WORKDIR /ndmspc
RUN export NDMSPC_LOG_CONSOLE=0; export NDMSPC_LOG_RUN=1; root -b -q /usr/share/ndmspc/tutorial/02_storage/NStorage01Gaus.C && \
  root -b -q /usr/share/ndmspc/tutorial/03_parameter/NParameter01Gaus.C && \
  root -b -q /usr/share/ndmspc/tutorial/04_customization/NCustomization01Gaus.C && \
  root -b -q /usr/share/ndmspc/tutorial/05_single_bining/NSingleBinning01Gaus.C && \
  root -b -q /usr/share/ndmspc/tutorial/05_single_bining/NSingleBinning01Gaus.C'("NNested01Gaus.root")' && \
  root -b -q /usr/share/ndmspc/tutorial/06_binnings/NBinnings01Gaus.C && \
  root -b -q /usr/share/ndmspc/tutorial/06_binnings/NBinnings01Gaus.C'("NBinnings01Gaus_odd.root",true)' && \
  root -b -q /usr/share/ndmspc/tutorial/06_binnings/NBinnings01GausStress.C 

# Copy only the React build from Stage 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD [ "/bin/bash","-c","ndmspc-server -m /usr/share/ndmspc/macros/builtin/httpNgntBase.C,/usr/share/ndmspc/macros/builtin/httpNgnt.C --html /usr/share/ndmspc/ndmspc-ui" ]
