%global debug_package %{nil}
%global source_date_epoch_from_changelog %{nil}

Name:       @PROJECT_NAME@
Version:	@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@
Release:	@PROJECT_VERSION_RELEASE@%{?dist}
Summary:	@PROJECT_DESCRIPTION@
Group:		System Environment/Libraries
License:	LGPL v3+
Source0:    %{name}-%{version}.tar.gz

%global with_ui 1
%global with_utils 0
%global with_jupyroot 0
%if 0%{?rhel} == 10 || 0%{?almalinux} == 10
%global with_numcal 0
%global with_taxi 1
%else
%if 0%{?rhel} == 9 || 0%{?almalinux} == 9
%global with_numcal 1
%global with_taxi 0
%global with_ui 0
%else
%global with_numcal 1
%global with_taxi 1
%endif
%endif

BuildRequires: systemd-rpm-macros
BuildRequires: git, gcc-c++, cmake
BuildRequires: json-devel zeromq-devel
BuildRequires: root, root-net-http, root-net-httpsniff
BuildRequires: root-roofit root-roofit-more
Requires:      root, root-netx, root-net-http, root-net-httpsniff, xrootd-client
Requires:      root-roofit root-roofit-more 

%if %{with_ui}
BuildRequires: nodejs, npm
%endif


%if %{with_utils}
BuildRequires: openssl-devel, libcurl-devel, libwebsockets-devel
Requires:      libwebsockets-devel
%endif

%if %{with_taxi}
BuildRequires: parquet-libs-devel
%endif

%if %{with_numcal}
BuildRequires: ginac-devel, cuba-devel
%endif

%description
@PROJECT_DESCRIPTION@
Obsoletes: ndmspc-server < %{version}


%if %{with_ui}
%package ui
Summary:  UI support for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig

%description ui
This package contains taxi support for @PROJECT_NAME@.
%endif

%if %{with_jupyroot}
%package jupyroot
Summary:  Jupyroot bindings for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig
Requires: python3-jupyroot, root-gui-browserv7-v7

%description jupyroot
This package contains Jupyroot bindings for @PROJECT_NAME@.
%endif

%if %{with_numcal}
%package numcal
Summary:  Numcal support for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig
Requires: ginac, cuba

%description numcal
This package contains numcal support for @PROJECT_NAME@.
%endif

%if %{with_taxi}
%package taxi
Summary:  Taxi support for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig

%description taxi
This package contains taxi support for @PROJECT_NAME@.
%endif

%prep
%setup -q

%build
mkdir build
cd build
cmake ../ \
-DCMAKE_INSTALL_PREFIX=/usr \
-DCMAKE_BUILD_TYPE=Release \
-DUSE_HEADER_PREFIX=ON \
-DBUILD_DOCUMENTATION=OFF \
-DWITH_TEST=OFF \
%if %{with_ui}
-DWITH_UI=ON \
%else
-DWITH_UI=OFF \
%endif
%if %{with_utils}
-DWITH_UTILS=ON \
%else
-DWITH_UTILS=OFF \
%endif
%if %{with_jupyroot}
-DWITH_JUPYROOT=ON \
%else
-DWITH_JUPYROOT=OFF \
%endif
%if %{with_taxi}
-DWITH_TAXI=ON \
%else
-DWITH_TAXI=OFF \
%endif
%if %{with_numcal}
-DWITH_NUMCAL=ON
%else
-DWITH_NUMCAL=OFF
%endif

make %{?_smp_mflags}
cd ../

%install
rm -rf %{buildroot}
cd build
make install DESTDIR=%{buildroot}

%post
%systemd_post ndmspc-http@*.service

%preun
%systemd_preun ndmspc-http@*.service

%postun
%systemd_postun ndmspc-http@*.service

%if %{with_jupyroot}
%preun jupyroot
%systemd_preun ndmspc-notebook@*.service
%postun jupyroot
%systemd_postun ndmspc-notebook@*.service
%post jupyroot
%systemd_post ndmspc-notebook@*.service
%endif

%files
%if %{with_numcal}
%exclude %{_libdir}/libNdmspcNumcal*
%exclude %{_includedir}/ndmspc/NNumcalManager.h
%endif
%{_libdir}/*
%{_bindir}/ndmspc-server
%{_bindir}/ndmspc-run
%{_bindir}/ndmspc-worker
%{_includedir}/*
%exclude %{_datadir}/%{name}/macros/taxi/*
%exclude %{_datadir}/%{name}/ndmspc-ui/*
%{_datadir}/%{name}/*
%{_sysconfdir}/systemd/user/ndmspc-http@.service
%{_sysconfdir}/%{name}/*
%{_sysconfdir}/profile.d/*
%{_unitdir}/ndmspc-http@.service

%if %{with_ui}
%files ui
%{_datadir}/%{name}/ndmspc-ui/*
%endif

%if %{with_numcal}
%files numcal
%{_libdir}/libNdmspcNumcal*
%{_includedir}/ndmspc/NNumcalManager.h
%{_bindir}/ndmspc-numcal
%endif

%if %{with_taxi}
%files taxi
%{_libdir}/libNdmspcTaxi*
%{_includedir}/ndmspc/NTaxi.h
%{_datadir}/%{name}/macros/taxi/*
%endif

%if %{with_jupyroot}
%files jupyroot
%{_unitdir}/ndmspc-notebook@.service
%{_sysconfdir}/systemd/user/ndmspc-notebook@.service
%endif

%changelog
