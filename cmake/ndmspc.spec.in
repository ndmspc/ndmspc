%global debug_package %{nil}
%global source_date_epoch_from_changelog %{nil}

Name:       @PROJECT_NAME@
Version:	@NDMSPC_RPM_VERSION@
Release:	@NDMSPC_RPM_RELEASE@%{?dist}
Summary:	@PROJECT_DESCRIPTION@
Group:		System Environment/Libraries
License:	LGPL v3+
Source0:    %{name}-%{version}.tar.gz
Obsoletes:  ndmspc-server < %{version}
# The web page used to be its own subpackage; it ships inside the main package now.
Obsoletes:  ndmspc-ui < %{version}
Provides:   ndmspc-ui = %{version}-%{release}

%global with_jupyroot 0
%global with_ai 1
%if 0%{?rhel} == 10 || 0%{?almalinux} == 10
%global with_numcal 0
%global with_taxi 1
%else
%if 0%{?rhel} == 9 || 0%{?almalinux} == 9
%global with_numcal 1
%global with_taxi 0
%global with_ai 0
%else
%global with_numcal 1
%global with_taxi 1
%endif
%endif

# Fedora >= 45 no longer ships root-net-davix; use the curl backend there, davix everywhere else.
%if 0%{?fedora} >= 45
%global root_net_pkg root-net-curl
%else
%global root_net_pkg root-net-davix
%endif

BuildRequires: systemd-rpm-macros
BuildRequires: git, gcc-c++, cmake, openssl-devel
BuildRequires: json-devel, zeromq-devel
%if 0%{?rhel} > 10 || 0%{?almalinux} > 10
BuildRequires: cpp-httplib-devel, cli11-devel
%endif
BuildRequires: root, root-net-http, root-net-httpsniff
BuildRequires: root-roofit root-roofit-more
Requires:      root, root-netx, root-net-http, root-net-httpsniff, %{root_net_pkg}, xrootd-client
Requires:      root-roofit root-roofit-more
# ndmspc-tutorials fetches ROOT's hsimple.C from the ROOT source on GitHub.
Requires:      curl

%if %{with_taxi}
BuildRequires: parquet-libs-devel
%endif

%if %{with_numcal}
BuildRequires: ginac-devel, cuba-devel
%endif

%description
@PROJECT_DESCRIPTION@


%if %{with_jupyroot}
%package jupyroot
Summary:  Jupyroot bindings for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig
Requires: python3-jupyroot, root-gui-browserv7-v7

%description jupyroot
This package contains Jupyroot bindings for @PROJECT_NAME@.
%endif

%if %{with_numcal}
%package numcal
Summary:  Numcal support for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig
Requires: ginac, cuba

%description numcal
This package contains numcal support for @PROJECT_NAME@.
%endif

%if %{with_taxi}
%package taxi
Summary:  Taxi support for @PROJECT_NAME@
Group:    Additional Packages
Requires: %{name} = %{version}-%{release}, pkgconfig

%description taxi
This package contains taxi support for @PROJECT_NAME@.
%endif

%prep
%setup -q

%build
mkdir build
cd build
cmake ../ \
-DCMAKE_INSTALL_PREFIX=/usr \
-DCMAKE_BUILD_TYPE=Release \
-DBUILD_DOCUMENTATION=OFF \
-DWITH_TEST=OFF \
@NDMSPC_SPEC_UI_VERSION_ARG@ \
%if %{with_jupyroot}
-DWITH_JUPYROOT=ON \
%else
-DWITH_JUPYROOT=OFF \
%endif
%if %{with_taxi}
-DWITH_TAXI=ON \
%else
-DWITH_TAXI=OFF \
%endif
%if %{with_numcal}
-DWITH_NUMCAL=ON \
%else
-DWITH_NUMCAL=OFF \
%endif
%if %{with_ai}
-DWITH_AI=ON
%else
-DWITH_AI=OFF
%endif


make %{?_smp_mflags}
cd ../

%install
rm -rf %{buildroot}
cd build
make install DESTDIR=%{buildroot}

rm -f %{buildroot}/%{_datadir}/doc/httplib/README.md
rm -f %{buildroot}/%{_datadir}/licenses/httplib/LICENSE

# ROOT discovers .rootmap files along Root.DynamicPath, which is
# ".:%{_libdir}/root:" - the dictionaries/rootmaps are installed in %{_libdir},
# so cling cannot autoload 'Ndmspc::*' and users have to #include the headers
# (e.g. <ndmspc/core/NGnTree.h>). Expose the ROOT artefacts where ROOT looks for
# them; the real libraries stay in %{_libdir}, so linking (-lNdmspcCore, ldd)
# is unaffected.
mkdir -p %{buildroot}%{_libdir}/root
for f in %{buildroot}%{_libdir}/libNdmspc*; do
  case "$f" in
    *.so|*.so.*|*.rootmap|*_rdict.pcm)
      ln -sf "../$(basename "$f")" "%{buildroot}%{_libdir}/root/$(basename "$f")"
      ;;
  esac
done

%post
%systemd_post ndmspc-http@*.service

%preun
%systemd_preun ndmspc-http@*.service

%postun
%systemd_postun ndmspc-http@*.service

%if %{with_jupyroot}
%preun jupyroot
%systemd_preun ndmspc-notebook@*.service
%postun jupyroot
%systemd_postun ndmspc-notebook@*.service
%post jupyroot
%systemd_post ndmspc-notebook@*.service
%endif

%files
%if %{with_numcal}
%exclude %{_libdir}/libNdmspcNumcal*
%exclude %{_includedir}/ndmspc/numcal/*.h
%endif
%{_libdir}/*
%{_bindir}/ndmspc-server
%{_bindir}/ndmspc-cli
%{_bindir}/ndmspc-run
%{_bindir}/ndmspc-worker
%{_bindir}/ndmspc-ws-client
%{_bindir}/ndmspc-mcp
%{_bindir}/ndmspc-tutorials
%if %{with_ai}
%{_bindir}/ndmspc-chat
%endif
%{_includedir}/*
%exclude %{_datadir}/%{name}/macros/taxi/*
%{_datadir}/%{name}/*
%{_sysconfdir}/systemd/user/ndmspc-http@.service
%{_sysconfdir}/%{name}/*
%{_sysconfdir}/profile.d/*
%{_unitdir}/ndmspc-http@.service

%if %{with_numcal}
%files numcal
%{_libdir}/libNdmspcNumcal*
%{_includedir}/ndmspc/numcal/*.h
%{_bindir}/ndmspc-numcal
%endif

%if %{with_taxi}
%files taxi
%{_libdir}/libNdmspcTaxi*
%{_includedir}/ndmspc/taxi/*.h
%{_datadir}/%{name}/macros/taxi/*
%endif

%if %{with_jupyroot}
%files jupyroot
%{_unitdir}/ndmspc-notebook@.service
%{_sysconfdir}/systemd/user/ndmspc-notebook@.service
%endif

%changelog
